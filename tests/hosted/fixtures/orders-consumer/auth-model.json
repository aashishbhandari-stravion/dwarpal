{
  "client": "orders-demo",
  "roles": {
    "manager": {
      "description": "grants staff; needs an MFA-verified session",
      "manages_members": true,
      "mfa_required": true,
      "permissions": ["members:manage", "orders:read:any"]
    },
    "staff": {
      "description": "reads every order; needs an MFA-verified session",
      "mfa_required": true,
      "permissions": ["orders:read:any"]
    },
    "customer": {
      "description": "granted automatically at first sign-in",
      "self_assignable": true,
      "permissions": ["orders:read:own"]
    }
  },
  "permissions": {
    "members:manage": "grant and revoke non-manager roles",
    "orders:read:own": "read orders the user owns",
    "orders:read:any": "read any order"
  }
}
