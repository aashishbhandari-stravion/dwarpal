{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": [
    "packages/core/**/*.d.ts",
    "packages/server/**/*.d.ts",
    "packages/browser/**/*.d.ts",
    "packages/emulator/**/*.d.ts",
    "tests/core/types/**/*.ts",
    "tests/server/types/**/*.ts",
    "tests/browser/types/**/*.ts",
    "tests/emulator/types/**/*.ts"
  ]
}
