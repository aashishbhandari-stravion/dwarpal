{
  "client": "example-studio",
  "roles": {
    "owner": {
      "description": "runs the studio",
      "manages_members": true,
      "mfa_required": true,
      "permissions": ["members:manage", "posts:publish", "posts:edit:any", "posts:read"]
    },
    "editor": {
      "description": "edits posts they wrote",
      "permissions": ["posts:edit:own", "posts:read"]
    },
    "member": {
      "description": "granted automatically at first sign-in",
      "self_assignable": true,
      "permissions": ["posts:read"]
    }
  },
  "permissions": {
    "members:manage": "grant and revoke non-manager roles",
    "posts:publish": "publish a post",
    "posts:edit:own": "edit posts the user authored",
    "posts:edit:any": "edit any post",
    "posts:read": "read posts"
  }
}
