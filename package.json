{
  "name": "@briqvent/dwarpal",
  "version": "0.0.0",
  "private": true,
  "description": "Authentication and role-based access kit for Supabase Auth: a pure core contract with validators and permission evaluation, a stateless Node server library, the auth-kit operator CLI with its SQL migrations, and a browser kit with default screens and prebuilt static-site assets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./packages/core/index.d.ts",
      "default": "./packages/core/index.js"
    },
    "./testing": {
      "types": "./packages/core/testing/index.d.ts",
      "default": "./packages/core/testing/index.js"
    },
    "./server": {
      "types": "./packages/server/index.d.ts",
      "default": "./packages/server/index.js"
    },
    "./server/operator": {
      "types": "./packages/server/operator.d.ts",
      "default": "./packages/server/operator.js"
    },
    "./server/hono": {
      "types": "./packages/server/hono.d.ts",
      "default": "./packages/server/hono.js"
    },
    "./browser": {
      "types": "./packages/browser/index.d.ts",
      "default": "./packages/browser/index.js"
    },
    "./browser/styles.css": "./packages/browser/styles.css",
    "./browser/dist/dwarpal-browser.js": "./packages/browser/dist/dwarpal-browser.js",
    "./browser/dist/dwarpal-browser.css": "./packages/browser/dist/dwarpal-browser.css",
    "./browser/dist/build-manifest.json": "./packages/browser/dist/build-manifest.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "auth-kit": "packages/server/cli/auth-kit.js"
  },
  "files": [
    "packages/core/**/*.js",
    "packages/core/**/*.d.ts",
    "packages/server/**/*.js",
    "packages/server/**/*.d.ts",
    "packages/browser/*.js",
    "packages/browser/*.d.ts",
    "packages/browser/lib/*.js",
    "packages/browser/styles.css",
    "packages/browser/dist/dwarpal-browser.js",
    "packages/browser/dist/dwarpal-browser.css",
    "packages/browser/dist/build-manifest.json",
    "supabase/migrations/*.sql",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test \"tests/core/**/*.test.js\" \"tests/server/*.test.js\" \"tests/cli/cli.test.js\" \"tests/browser/*.test.js\" \"tests/emulator/*.test.js\" \"tests/examples/*.test.js\" \"tests/package/*.test.js\"",
    "test:browser-dom": "node --test \"tests/browser/dom/*.test.js\"",
    "test:browser-integration": "node --test \"tests/integration/*.playwright.test.js\"",
    "test:browser-sensitivity": "node tests/browser/sensitivity.js",
    "test:emulator": "node --test \"tests/emulator/*.test.js\"",
    "test:sql-server": "node tests/sql/run.js tests/server/sql/manager.test.js tests/server/sql/mfa-reset.test.js tests/server/sql/operator.test.js tests/server/sql/catalog.test.js tests/cli/sql-flow.test.js",
    "test:examples-sql": "node tests/sql/run.js tests/examples/sql/rls-consumer.test.js",
    "test:examples-built": "node scripts/check-examples.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "prepack": "node scripts/build-browser.mjs --quiet",
    "check:types": "tsc -p tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run check:types && npm run check:package"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "hono": "4.13.9",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
