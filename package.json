{
  "name": "@briqvent/dwarpal",
  "version": "0.0.0",
  "private": true,
  "description": "Authentication and role-based access kit for Supabase Auth: pure core contract, validators and permission evaluation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./packages/core/index.d.ts",
      "default": "./packages/core/index.js"
    },
    "./testing": {
      "types": "./packages/core/testing/index.d.ts",
      "default": "./packages/core/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/core/**/*.js",
    "packages/core/**/*.d.ts"
  ],
  "scripts": {
    "test": "node --test \"tests/core/**/*.test.js\"",
    "check:types": "tsc -p tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run check:types && npm run check:package"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
